{
    "name": "@wae/open-pdf",
    "version": "0.0.2",
    "description": "Generate, merge, split and inspect PDFs without external PDF libraries",
    "license": "MPL-2.0",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-pdf": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build:test": "tsc -p tsconfig.test.json",
        "example": "node dist-test/examples/report-workflow.js",
        "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/tests/smoke.test.js dist-test/tests/error-contract.test.js dist-test/tests/page-selection-binding.test.js dist-test/tests/form-fill-binding.test.js dist-test/tests/cli-envelope.test.js dist-test/tests/locale-parity.test.js"
    },
    "keywords": [
        "pdf",
        "merge",
        "split",
        "metadata",
        "generate",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenPDF.git",
        "directory": "projects/packages/open-pdf"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@wae/commander": "0.0.7"
    },
    "optionalDependencies": {
        "@wae/open-pdf-darwin-arm64": "workspace:*",
        "@wae/open-pdf-darwin-x64": "workspace:*",
        "@wae/open-pdf-linux-arm64": "workspace:*",
        "@wae/open-pdf-linux-x64": "workspace:*",
        "@wae/open-pdf-win32-x64": "workspace:*"
    }
}
