{
    "name": "open-pdf-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "description": "OpenPDF workspace: PDF generation, merge, split, metadata and outline extraction",
    "keywords": ["pdf", "merge", "split", "metadata", "outline", "generate"],
    "license": "MPL-2.0",
    "repository": "https://github.com/nyar-os/OpenPDF",
    "scripts": {
        "doc": "cargo doc --no-deps --all-features",
        "test:rust": "cargo test",
        "fmt": "cargo fmt --all",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "cargo upgrade --workspace",
        "check:rust": "cargo fmt -p open-pdf-core -p open-pdf-napi -- --check && cargo clippy -p open-pdf-core -p open-pdf-napi --all-targets -- -D warnings && cargo test -p open-pdf-core -p open-pdf-napi",
        "build:napi": "cargo build -p open-pdf-napi",
        "build:ts": "pnpm --filter @wae/open-pdf run build",
        "build": "pnpm run build:napi && pnpm run build:ts",
        "typecheck": "pnpm -r --filter \"./projects/packages/*\" run typecheck",
        "test": "pnpm -r --filter \"./projects/packages/*\" run test"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.15",
        "@types/node": "^22.20.4",
        "@wae/wae": "0.0.6",
        "typescript": "^5.9.2"
    }
}
